# Dikelola Ansible (role ssh_hardening). Jangan edit manual.
# File lain di sshd_config.d/ bisa menimpakan nilai ini jika namanya urut setelahnya.

Port {{ ssh_port }}
AddressFamily inet

PermitRootLogin {{ ssh_permit_root_login }}
PasswordAuthentication {{ ssh_password_authentication }}
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
UsePAM yes
AuthenticationMethods publickey

MaxAuthTries {{ ssh_max_auth_tries }}
MaxSessions 4
LoginGraceTime {{ ssh_login_grace_time }}
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
AllowTcpForwarding {{ ssh_allow_tcp_forwarding }}

{% if ssh_banner_enabled | bool %}
Banner /etc/issue.net
{% endif %}
LogLevel VERBOSE
PrintLastLog yes

{% if ssh_allow_users | length > 0 %}
AllowUsers {{ ssh_allow_users | join(' ') }}
{% endif %}
