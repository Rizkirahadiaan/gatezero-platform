# Secrets untuk Ansible — JANGAN commit file hasil dekripsi.
#
# File ini adalah SOPS-encrypted YAML berisi variabel environment.
# Formatnya: key=value (bukan YAML), karena dipakai `sops exec-env`.
#
# Cara membuat:
#   1. generate nilai:
#        kubeadm certs certificate-key          # 64 hex char  -> K8S_CERT_KEY
#        head -c 32 /dev/urandom | base64       # 44 char b64  -> K8S_ENCRYPTION_KEY
#   2. isi secrets.env dengan nilai di atas
#   3. enkripsi:
#        sops -e secrets.env > secrets.env.enc
#        rm -f secrets.env
#   4. jalankan:
#        sops exec-env secrets.env.enc -- ansible-playbook site.yml
#
# Catat nilai K8S_ENCRYPTION_KEY di tempat offline (password manager).
# Kalau hilang, semua Secret di etcd tidak bisa dibaca.

K8S_CERT_KEY=PLEASE_GENERATE_WITH_kubeadm_certs_certificate-key
K8S_ENCRYPTION_KEY=PLEASE_GENERATE_32_BYTES_BASE64
